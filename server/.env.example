NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/eventoria
# Optional fallback when the system DNS refuses MongoDB Atlas SRV lookups.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
CLIENT_URL=http://localhost:5173,http://localhost:5174
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_SECRET=development-only-change-me

